# ── Business Lead · Google API credentials ───────────────────────────────────
# Enable "Places API (New)" and "Geocoding API" in your Google Cloud project,
# then create an API key: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=AIza...

# ── The format every run writes ──────────────────────────────────────────────
# csv, excel, pdf or json. The session never asks: each search is named after
# itself and written in this format, into output/<date>/.
PLACES_FORMAT=csv

# ── Free-tier caps (whole numbers, at least 1; flags still win for one run) ──
# Daily: calls allowed per day, instead of the default month-remainder ÷ days
# left. Monthly: the ceiling the ledger enforces — set it lower than Google's
# allowance to be safer, or higher if Google changes its tier. The caps govern
# searches; geocoding keeps its own 10,000/month allowance.
# BUSINESSLEAD_DAILY_CAP=60
# BUSINESSLEAD_MONTHLY_CAP=800

# ── Optional defaults (any of these can still be overridden by CLI flags) ────
# PLACES_LOCATION=Bengaluru, India
# PLACES_CATEGORY=dentist
# PLACES_NAME=Apollo Pharmacy
# PLACES_TYPE=dentist          # Google Places type id, same as --type
# PLACES_RADIUS=15000          # metres
# PLACES_LANGUAGE=en

# ── The country your searches are in ─────────────────────────────────────────
# A location has to name a country — there are three Delhis and a Paris in Texas,
# and Google would geocode a bare one to whichever it liked. Set this and it is
# named for every search, so "Delhi" or "Nashik" on its own is enough.
# PLACES_REGION=in

# ── Places the offline check doesn't know yet ────────────────────────────────
# A renamed city, a district that was just split off, a suburb too small for
# GeoNames, a country spelled differently. For more than a place or two, use the
# locations file instead — `businesslead --locations` prints the path and creates
# it, and it takes countries and states as well as cities.
# Separate with commas; add ":<country>" (ISO code or name) if you want a postal
# code standing next to it checked against the right country.
# PLACES_EXTRA_LOCATIONS=Prayagraj:IN, Chhatrapati Sambhajinagar:India, Baner Gaon

# ── Where the places you add by hand live ────────────────────────────────────
# Default: locations.txt beside this file if there is one, otherwise
# ~/.config/businesslead/locations.txt.
# BUSINESSLEAD_LOCATIONS_FILE=./locations.txt
